# Environment Variables Example
# Copy this file to .env.local for local development

# Backend API URL (server-side routes)
DJANGO_API_URL=http://localhost:8002

# Same API URL for browser requests. Required; without it the site calls production.
NEXT_PUBLIC_API_URL=http://localhost:8002

# Canonical site URL. Metadata, sitemap, and share links use this host.
NEXT_PUBLIC_SITE_URL=https://ludmilpaulo.com

# Unused. Meetings are booked through the Django API (Meeting types and
# Weekly hours in the admin). Leave this empty.
NEXT_PUBLIC_CAL_USERNAME=

# Optional Search Console and Bing verification tokens. Leave empty until the properties exist.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Public Google OAuth client id. The same value must be set as GOOGLE_OAUTH_CLIENT_ID on the API.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
